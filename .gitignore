.DS_Store
/target
*.log

# Local prototype config with server credentials - never commit
config.local.json

# Swift app build artifacts
macapp/.build/
macapp/build/
# iOS spike harness bundle (built by packaging/ios/build-harness.sh)
packaging/ios/NZBFastHarness.app/

# Runtime SQLite index + WAL sidecars (churn every daemon run)
*.db
*.db-shm
*.db-wal

# Daemon runtime output / spool
/downloads/
/watch/
/ddash/
.spool/

# Bundle build output
/dist/
/packaging/*/nzbfast-*-getting-started.pdf

# daemon runtime settings (written by the dashboard) + the persist
# layer's crash-safety siblings
settings.json
packaging/windows/stage/
packaging/windows/out/
packaging/mac/build/
# .deb / .rpm built by packaging/linux/make-packages.sh
packaging/linux/out/
settings.json.bak
settings.json.corrupt
# a bare key dumped out of settings.json to talk to a local daemon -
# the one file in this list that is a live credential on its own
apikey

# field-repro NZBs (real message-ids - never publish)
repro-nzbs/

# update-signing private key, should a rotation ever drop one. Offline
# secret - must never be committed.
docs/ROTATE-KEY-SECRET.txt

# config backups can hold provider credentials (same reason
# config.local.json above is ignored); conntune output + local agent
# tooling scratch are per-machine artifacts, never repo content.
config.local.json.bak
conntune.json
.agents/

# generated by tools/stage-manual.py from docs/MANUAL*.html for the website copy
website/MANUAL.html
website/MANUAL.*.html

# daemon runtime state at the repo root (the dev daemon runs from the
# checkout; siblings config.local.json/settings.json are ignored above)
runtime.json

# the archive-password list the extractor reads, at the repo root only.
# It is user content - real passwords for real posts - and the dev daemon
# writes one here whenever it runs from the checkout. Root-anchored so a
# committed test fixture of the same name stays possible.
/passwords.txt

# per-machine Claude Code launch config + agent worktrees (worktrees
# were only in .git/info/exclude before, which a fresh clone loses)
.claude/launch.json
.claude/worktrees/

# merge debris and editor state
*.orig
*.rej
.vscode/
.idea/
.scan-stamps

# Torture-soak corpora: built by make_adversarial*.sh / fetch_fixtures*.sh,
# large (round 4's is 1.5 GB with its 1 GiB advYA payload) and disposable.
# The generators and the ground-truth manifests are what get committed.
research/torture-soak-2026-08-11/adversarial*/
research/torture-soak-2026-08-11/fixtures*/
