#!/bin/sh
# Pick the download location and write the service's environment file.
#
# The whole point of this package is that a DSM user answers no questions
# and edits no files, so this script has to choose well without asking.
set -e

PKG=nzbfast
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"
DEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
ENVFILE="$VAR/nzbfast.env"
PORT="@@PORT@@"

# Refuse to install on top of something already serving this port, rather
# than installing a package whose service then fails to bind every time
# with the reason only in a log the GUI does not surface.
#
# The likely cause is nzbfast already running as a Container Manager
# container, and that case deserves more than "port in use": two nzbfast
# instances pointed at one download folder would both claim the same jobs
# and write over each other, which is worse than either a clash or a clean
# refusal. Migrating means stopping the container first, on purpose.
if [ -z "${SPK_TEST_SKIP_PORTCHECK:-}" ] \
   && command -v curl >/dev/null 2>&1 \
   && curl -s -m 3 -o /dev/null "http://127.0.0.1:$PORT/"; then
    echo "nzbfast: something is already serving port $PORT on this NAS." >&2
    echo "nzbfast: if that is nzbfast running under Container Manager," >&2
    echo "nzbfast: stop and remove that container first - running both" >&2
    echo "nzbfast: against the same download folder would have them" >&2
    echo "nzbfast: fighting over the same jobs." >&2
    echo "nzbfast: your settings and downloads are not touched by this." >&2
    exit 1
fi

# The package is built noarch and carries a binary for each supported
# architecture, so there is ONE download and one package-source URL for
# every model - DSM's package feed protocol filters by arch server-side,
# which a static host cannot do, and asking a user to know whether their
# NAS is ARM or Intel is exactly the friction this package exists to
# remove. The cost is carrying one unused binary; the benefit is that
# nobody can pick the wrong file.
#
# noarch also means DSM will happily install this on an architecture we do
# not ship, so refuse clearly here rather than leaving a package that
# installs and then dies at every start with nothing explaining why.
if [ -d "$DEST/bin" ]; then
    # SPK_TEST_UNAME lets the test harness pretend to be another model.
    # DSM never sets it.
    machine="${SPK_TEST_UNAME:-$(uname -m 2>/dev/null || echo unknown)}"
    case "$machine" in
        x86_64|amd64)   want=nzbfast-x86_64 ;;
        aarch64|arm64)  want=nzbfast-aarch64 ;;
        *)
            echo "nzbfast: this NAS reports architecture '$machine', which" >&2
            echo "nzbfast: this package does not support. nzbfast ships" >&2
            echo "nzbfast: 64-bit builds only (x86_64 and aarch64)." >&2
            exit 1
            ;;
    esac
    if [ ! -f "$DEST/bin/$want" ]; then
        echo "nzbfast: package is missing $want - build is broken." >&2
        exit 1
    fi
    ln -sf "$want" "$DEST/bin/nzbfast"
    # Drop the binary we cannot run, so the installed package does not sit
    # on twice the disk it needs for the rest of its life.
    for other in nzbfast-x86_64 nzbfast-aarch64; do
        [ "$other" = "$want" ] || rm -f "$DEST/bin/$other"
    done
fi

# An upgrade must never move somebody's downloads. If they already have an
# env file, it is the source of truth and we leave it exactly alone.
if [ -f "$ENVFILE" ]; then
    exit 0
fi

# Find the volume with the most free space. A NAS with one volume gets
# /volume1 either way; a multi-volume box gets the roomy one rather than
# whichever sorts first, because downloads are the large thing here.
#
# Only SHARED FOLDERS appear in File Station. A bare directory under
# /volume1 is invisible there, so a user who cannot find their downloads
# would reasonably conclude nothing downloaded. That makes "is there a
# share I can use" the primary question and free space only a tie-break:
# picking the roomiest volume first would happily land on a big empty
# second volume with no shares on it, which is the worst answer available.
#
# SPK_TEST_ROOT exists so packaging/tests can exercise this against a fake
# volume layout. DSM never sets it, so on a real NAS it is empty and the
# paths below are the literal /volumeN.
best_vol=""
best_free=0
best_share=""
fallback_vol=""
fallback_free=0
for v in "${SPK_TEST_ROOT:-}"/volume1 "${SPK_TEST_ROOT:-}"/volume2 \
         "${SPK_TEST_ROOT:-}"/volume3 "${SPK_TEST_ROOT:-}"/volume4 \
         "${SPK_TEST_ROOT:-}"/volume5 "${SPK_TEST_ROOT:-}"/volume6 \
         "${SPK_TEST_ROOT:-}"/volume7 "${SPK_TEST_ROOT:-}"/volume8; do
    [ -d "$v" ] || continue
    # -P: POSIX output, one row per filesystem. Without it a long
    # device name can wrap onto a second line and NR==2 reads a device
    # name where the numbers should be.
    free=$(df -Pk "$v" 2>/dev/null | awk 'NR==2 {print $4}')
    case "$free" in ''|*[!0-9]*) free=0 ;; esac

    # Roomiest volume overall, used only if nothing has a usable share.
    if [ "$free" -gt "$fallback_free" ]; then
        fallback_free="$free"
        fallback_vol="$v"
    fi

    # DSM filesystems are case-sensitive and the stock share is
    # capitalised ("Downloads"), so both spellings have to be listed.
    for share in downloads Downloads download Download media Media video Video; do
        # Free space is the tie-break between volumes that HAVE a
        # share, never a condition for taking one. df can report nothing
        # for reasons that say nothing about the volume, and requiring
        # free > 0 turned that into "no share anywhere" and sent the
        # downloads to package storage, invisible in File Station.
        if [ -d "$v/$share" ] \
           && { [ -z "$best_share" ] || [ "$free" -gt "$best_free" ]; }; then
            best_free="$free"
            best_vol="$v"
            best_share="$share"
            break
        fi
    done
done
[ -n "$fallback_vol" ] || fallback_vol="${SPK_TEST_ROOT:-}/volume1"

# A non-default port means a second instance built deliberately, so give
# it its own folder. Sharing a download folder between two running
# instances is not a port clash, it is two daemons claiming the same jobs.
DIRNAME=nzbfast
[ "$PORT" = "6789" ] || DIRNAME="nzbfast-port$PORT"

BASE=""
if [ -n "$best_share" ]; then
    BASE="$best_vol/$best_share/$DIRNAME"
else
    best_vol="$fallback_vol"
fi
if [ -z "$BASE" ]; then
    BASE="$VAR"
    echo "nzbfast: no downloads/media shared folder found on $best_vol." >&2
    echo "nzbfast: downloads will go to $BASE/downloads for now." >&2
    echo "nzbfast: to put them somewhere you can browse in File Station," >&2
    echo "nzbfast: make a shared folder, then change the download folder" >&2
    echo "nzbfast: in the nzbfast dashboard under Settings." >&2
fi

# DSM creates var/ owned by this package's service account, whose name
# differs between DSM builds and package origins. Reading it off the
# directory DSM just made is more reliable than hardcoding a guess.
owner=$(stat -c %U "$VAR" 2>/dev/null || echo "")
group=$(stat -c %G "$VAR" 2>/dev/null || echo "")

# A directory can be searchable without being writable, and [ -d ] passes
# on the x bit alone. A Container Manager migration leaves
# <share>/nzbfast/downloads owned by the container's PUID at mode 0755, so
# once the admin grants the package account access to the SHARE, the
# pre-existing children are still read-only to us. Persisting one of those
# as the download folder installs cleanly, starts cleanly, and then fails
# every single job - with the reason only in a log the GUI does not
# surface, which is the failure the rest of this script exists to prevent.
#
# Create, rename, then delete: DSM's ACLs make "delete" a right of its
# own, so being able to create a file somewhere does not prove we can
# finish a download and tidy up after it. This runs inside somebody's live
# download folder, so it cleans up on every path.
dir_writable() {
    _p="$1/.nzbfast-write-test.$$"
    ( umask 077; : > "$_p" ) 2>/dev/null || { rm -f "$_p" 2>/dev/null; return 1; }
    if ! mv "$_p" "$_p.2" 2>/dev/null; then
        rm -f "$_p" 2>/dev/null
        return 1
    fi
    rm -f "$_p.2" 2>/dev/null || return 1
    [ ! -e "$_p.2" ] || return 1
    return 0
}

# Create the pair under $1, chowning ONLY what we actually create.
#
# Never chown something that was already there. The obvious path,
# <share>/nzbfast, is exactly what an existing Container Manager install
# uses - config, index.db, apikey, downloads and watch all live under it -
# so anyone migrating from Docker has one sitting there full of live data.
# Recursively chowning that to the package account would take a running
# install's files away from it, to fix a problem they did not have.
#
# Returns non-zero without side effects if the location is unusable.
make_dirs() {
    _base="$1"
    _reused=""
    for _d in "$_base/downloads" "$_base/watch"; do
        if [ -d "$_d" ]; then
            dir_writable "$_d" || return 1
            _reused="$_reused $_d"
            continue
        fi
        mkdir -p "$_d" 2>/dev/null || return 1
        if [ -n "$owner" ] && [ "$owner" != "UNKNOWN" ]; then
            chown -R "$owner:${group:-$owner}" "$_d" 2>/dev/null || true
        fi
    done
    REUSED="$_reused"
    return 0
}

# A DSM 7 package runs as its own internal user, and that user has NO
# access to shared folders until an administrator grants it in DSM. A
# shared folder visible from a root shell is therefore not one this script
# can write to: /volume1/Downloads exists and is mode 777, and mkdir still
# failed with "cannot create directory '/volume1/Downloads'" because the
# path is not visible from in here at all.
#
# So install must never DEPEND on a shared folder. Falling back to the
# package's own storage keeps the one-click install working on every NAS,
# and moving downloads somewhere browsable becomes a deliberate choice
# made afterwards in DSM, where granting that permission is a supported
# operation rather than something an install script forces.
REUSED=""
if ! make_dirs "$BASE"; then
    echo "nzbfast: cannot write to $BASE." >&2
    echo "nzbfast: this package's user has not been granted access to" >&2
    echo "nzbfast: that shared folder. That is normal on DSM 7, not a" >&2
    echo "nzbfast: fault - using the package's own storage instead." >&2
    echo "nzbfast: to keep downloads in a shared folder: Control Panel >" >&2
    echo "nzbfast: Shared Folder > Edit > Permissions > System internal" >&2
    echo "nzbfast: user, give 'nzbfast' read/write, then set the download" >&2
    echo "nzbfast: folder in the nzbfast dashboard." >&2
    BASE="$VAR"
    if ! make_dirs "$BASE"; then
        echo "nzbfast: cannot write to its own storage at $BASE either." >&2
        exit 1
    fi
fi
OUT="$BASE/downloads"
WATCH="$BASE/watch"

if [ -n "$REUSED" ]; then
    echo "nzbfast: reusing existing folders, ownership left as it is:" >&2
    for d in $REUSED; do echo "nzbfast:   $d" >&2; done
fi

umask 077
cat > "$ENVFILE" <<EOF
# nzbfast service settings. Edit and restart the package to change them.
NZBFAST_PORT=$PORT
NZBFAST_OUT=$OUT
NZBFAST_WATCH=$WATCH
EOF
if [ -n "$owner" ] && [ "$owner" != "UNKNOWN" ]; then
    chown "$owner:${group:-$owner}" "$ENVFILE" 2>/dev/null || true
fi

exit 0
