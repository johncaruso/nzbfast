#!/bin/sh
# Start, stop and report the daemon - WITHOUT systemd, and without needing
# root for any of it.
#
# The obvious DSM 7 design is a systemd unit plus `synosystemctl start` from
# here, and it cannot work for an unsigned package. Measured on a DSM 7.3
# box, not inferred:
#   - DSM runs these control scripts as the package's own unprivileged
#     account, and `synosystemctl` needs root: as root it prints
#     "[pkg-nzbfast] started.", as the package account "Fail to start []."
#   - conf/privilege CAN request `run-as: root` per action, and DSM then
#     refuses to install the package at all: error 319, "invalid package
#     privilege content". Root privilege requires a Synology-signed
#     package, which a community package will never be.
#   - Dropping this script so DSM starts a unit itself is not an option
#     either: INFO must then drop startable="yes", and removing either one
#     alone makes the package invalid while removing both fails the install.
# So the daemon is launched directly, by us, as the account we already are.
# That is the whole reason this script exists in this shape - do not
# "modernise" it back onto systemd.
#
# What is given up: systemd's Restart=on-failure. DSM still starts the
# package at boot by calling this script, so that is a fair trade for a
# package that installs at all.
PKG=nzbfast
VAR="/var/packages/$PKG/var"
DEST="/var/packages/$PKG/target"
BIN="$DEST/bin/nzbfast"
ENVFILE="$VAR/nzbfast.env"
PIDFILE="$VAR/nzbfast.pid"
LOGFILE="$VAR/nzbfast.log"

# Defaults matter: a missing env file must not silently start the daemon
# with empty paths, which would drop downloads in the working directory.
NZBFAST_PORT=6789
NZBFAST_OUT="$VAR/downloads"
NZBFAST_WATCH="$VAR/watch"
# shellcheck disable=SC1090  # written at install time, not in the repo
[ -f "$ENVFILE" ] && . "$ENVFILE"

running() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    # /proc rather than `kill -0`, which also succeeds for a process we do
    # not own, and rather than pgrep, which DSM does not ship.
    [ -d "/proc/$pid" ] || return 1
    # Match on OUR config path, not just the process name. A NAS running
    # nzbfast in Container Manager as well as this package has two
    # processes both called "nzbfast", so a name check alone is ambiguous:
    # after a reboot the stale pid in this file can land on the container's
    # daemon, `running` reads true, start does nothing, and DSM reports the
    # package started while nothing serves its port. The config path is
    # unique to this package, so this cannot confuse the two.
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q -- "$VAR/config.json"
}

case "$1" in
    start)
        if running; then
            echo "nzbfast is already running."
            exit 0
        fi
        if [ ! -x "$BIN" ]; then
            echo "nzbfast: $BIN is missing or not executable." >&2
            exit 1
        fi
        # Working directory is $VAR so relative state (index.db) lands on
        # the package's own storage, matching the container's WORKDIR.
        cd "$VAR" || exit 1
        # DSM owns this port. It is baked into the package's `adminport` at
        # build time, which is what DSM's own Open button uses, and into
        # $ENVFILE at install time - neither of which nzbfast can rewrite.
        # A port saved in the dashboard would move the listener away from
        # both, so the setting is refused with an explanation instead.
        NZBFAST_PORT_LOCKED=1
        export NZBFAST_PORT_LOCKED
        nohup "$BIN" serve \
            --config "$VAR/config.json" \
            --port "$NZBFAST_PORT" \
            --out "$NZBFAST_OUT" \
            --watch "$NZBFAST_WATCH" \
            >> "$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"
        # Confirm it is still alive rather than reporting success for a
        # process that exited immediately - the failure mode that makes a
        # broken package look installed.
        #
        # It has to DWELL. `running` is satisfied the moment the forked
        # process exists, which is true microseconds after the `&` above,
        # so checking once and exiting 0 reported a successful start for
        # a daemon that then died on an unreadable config, a rejected API
        # key or a port already bound - DSM recorded the package as
        # started with nothing serving its port, which is the exact
        # outcome this loop was written to prevent. Require it to still
        # be there after the startup work that can fail.
        i=0
        alive=0
        while [ "$i" -lt 15 ]; do
            sleep 1
            i=$((i + 1))
            if running; then
                alive=$((alive + 1))
                if [ "$alive" -ge 3 ]; then
                    echo "nzbfast started on port $NZBFAST_PORT."
                    exit 0
                fi
            else
                # Not up yet (still exec'ing), or up and gone again.
                # Either way the count restarts: only CONSECUTIVE
                # seconds of life count as staying running.
                alive=0
            fi
        done
        echo "nzbfast failed to stay running - see $LOGFILE" >&2
        tail -5 "$LOGFILE" 2>/dev/null >&2
        rm -f "$PIDFILE"
        exit 1
        ;;
    stop)
        if ! running; then
            rm -f "$PIDFILE"
            echo "nzbfast is not running."
            exit 0
        fi
        pid=$(cat "$PIDFILE")
        kill "$pid" 2>/dev/null
        i=0
        while [ "$i" -lt 20 ]; do
            running || break
            i=$((i + 1))
            sleep 1
        done
        if running; then
            kill -9 "$pid" 2>/dev/null
            sleep 1
        fi
        rm -f "$PIDFILE"
        echo "nzbfast stopped."
        exit 0
        ;;
    status)
        # DSM reads the exit code, not the text: 0 running, 1 stopped.
        if running; then
            echo "nzbfast is running."
            exit 0
        fi
        echo "nzbfast is not running."
        exit 1
        ;;
    *)
        echo "usage: $0 {start|stop|status}" >&2
        exit 1
        ;;
esac
