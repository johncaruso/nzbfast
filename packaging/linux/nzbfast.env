# nzbfast service options - /etc/nzbfast/nzbfast.env
#
# This is the ONLY file the .deb / .rpm owns under /etc. Edit it and the
# package upgrade keeps your version (dpkg conffile / rpm noreplace).
# Everything else nzbfast writes - config.json, settings.json, apikey,
# the queue spool, the index - lives in the data directory below and is
# never touched by an install, an upgrade or a removal.
#
# After editing:  sudo systemctl restart nzbfast

# Dashboard + API port. Changing it here and in the dashboard both work;
# whichever was saved in the dashboard wins on the next start.
NZBFAST_PORT=6789

# Where the daemon keeps everything. The three paths below are the
# per-install "settings folder" the manual points at for backups.
NZBFAST_CONFIG=/var/lib/nzbfast/config.json
NZBFAST_OUT=/var/lib/nzbfast/downloads
NZBFAST_WATCH=/var/lib/nzbfast/watch
NZBFAST_INDEX_DB=/var/lib/nzbfast/index.db

# Downloading somewhere else (a NAS mount, a second disk)?
# Two steps, and the second one is easy to miss: the unit runs with
# ProtectSystem=strict, so every path outside /var/lib/nzbfast is
# READ-ONLY to the daemon until you name it. Point NZBFAST_OUT at the new
# folder, then:
#
#   sudo systemctl edit nzbfast
#
# and add, in the editor it opens:
#
#   [Service]
#   ReadWritePaths=/mnt/media
#
# Without that second step jobs fail with permission errors on a folder
# that looks perfectly writable from a root shell. The same applies to a
# download folder changed in the dashboard rather than here.
